+def epoch_window(manifest: dict[str, Any]) -> dict[str, Any] | None:
+    """读取恢复包的 epoch 块；老包（无 epoch）返回 ``None``。"""
+    epoch = manifest.get("epoch")
+    if not isinstance(epoch, dict):
+        return None
+    try:
+        started = int(epoch.get("snapshot_started_ms") or 0)
+        finished = int(epoch.get("snapshot_finished_ms") or 0)
+    except (TypeError, ValueError):
+        raise ValueError("恢复包 epoch 时间戳畸形")
+    tolerance = int(epoch.get("tolerance_ms") or DEFAULT_EPOCH_TOLERANCE_MS)
+    return {"epoch_id": str(epoch.get("epoch_id") or ""), "started": started,
+            "finished": finished, "tolerance": tolerance,
+            "profile": str(epoch.get("profile") or ""),
+            "environment": str(epoch.get("environment") or "")}
+
+
+def _assert_same_epoch(files: dict[str, Any], window: dict[str, Any]) -> None:
+    """逐成员校验 ``snapshot_at_ms`` 落在同一 epoch 窗口内（U13）。
+
+    这是"数据库里的持仓"与"JSON 里的资金/通道/风控水位"来自同一时刻的可执行
+    证明；缺时间戳或越界一律拒绝，而不是"看起来完整就放行"。
+    """
+    low = window["started"] - window["tolerance"]
+    high = window["finished"] + window["tolerance"]
+    for key, metadata in files.items():
+        if not isinstance(metadata, dict):
+            continue
+        stamp = metadata.get("snapshot_at_ms")
+        if not isinstance(stamp, int) or isinstance(stamp, bool):
+            raise ValueError(f"恢复包成员缺少 snapshot_at_ms: {key}")
+        if not low <= stamp <= high:
+            raise ValueError(f"恢复包成员不在同一 epoch 窗口内: {key}")
+
+
