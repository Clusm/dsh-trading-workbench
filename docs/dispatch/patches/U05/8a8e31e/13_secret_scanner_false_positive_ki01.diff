+def _is_python_code_reference(value: str) -> bool:
+    """裸值是否是 Python 源码里的代码引用（标识符/属性链）而非内联字面量。"""
+    text = value.strip()
+    return bool(text) and bool(_PY_CODE_REFERENCE_RE.fullmatch(text))
