+def reason_from_quality(quality: Mapping[str, Any] | None) -> DecisionReason | None:
+    """把 ``data_quality`` 的可观测缺口映射为 U05 原因码（供执行/审计侧消费）。
+
+    判定只看**结构化事实**：``ok=False`` / ``issues`` 非空 / 有源不可用 →
+    ``DATA_UNAVAILABLE``；部分源可用（取到但不全）另附 ``RESEARCH_INCOMPLETE``
+    辅因——"完全取不到"与"只拿到一部分"是两件不同的事。无缺口返回 ``None``。
+    """
+    payload = dict(quality or {})
+    if not payload:
+        return None
+    issues = [str(item) for item in (payload.get("issues") or [])]
+    sources = payload.get("sources") if isinstance(payload.get("sources"), Mapping) else {}
+    unavailable = sorted(
+        str(name) for name, item in sources.items()
+        if isinstance(item, Mapping) and not item.get("available", True)
+    )
+    missing = [str(item) for item in (payload.get("missing_fields") or [])]
+    if payload.get("ok", True) and not issues and not unavailable:
+        return None
+    degraded = bool(sources) and bool(unavailable) and len(unavailable) < len(sources)
+    return reason_from_source_errors(
+        issues + [f"source_unavailable:{name}" for name in unavailable] + missing,
+        labels=("market_query",), degraded=degraded,
+    )
+
