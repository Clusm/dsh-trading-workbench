+# --------------------------------------------------------------------------
+# U15-FU2：哨兵（"unknown"）不得从**另外两条路径**读成合法运行代
+#   残留 A（源头）：`RunRegistry.load()` 读入的哨兵实例号 → 视为无记录 → 重铸
+#   残留 B（授权）：`verify_account_binding` / K04 门禁认识哨兵 → 绑定不通过
+# 哨兵名单**复用** U15-FU1（`RUNTIME_INSTANCE_PLACEHOLDERS` /
+# `is_placeholder_runtime_instance_id` / `resolve_runtime_instance_id`），本文件
+# 不另立第二份名单。
+# --------------------------------------------------------------------------
+def _u15_fu2_binding_guard() -> str:
+    """两态探测：授权路径（runtime_identity）侧的 U15-FU2 交付物是否在位。"""
+    return str(getattr(
+        runtime_identity_module, "U15_FU2_RUNTIME_INSTANCE_SENTINEL_GUARD", ""))
+
+
+def _u15_fu2_registry_guard() -> str:
+    """两态探测：源头（RunRegistry）侧的 U15-FU2 交付物是否在位。"""
+    from core.ops import supervision as supervision_module  # noqa: PLC0415
+
+    return str(getattr(
+        supervision_module, "U15_FU2_RUN_REGISTRY_SENTINEL_GUARD", ""))
+
+
+def _sentinel_generation(instance: str, *, started_at: float = 1000.0):
+    return mint_runtime_generation(
+        environment="demo",
+        account_ref=derive_account_ref("demo", declared_account_ref="acct-a"),
+        runtime_instance_id=instance, started_at=started_at)
+
+
+def check_sentinel_runtime_instance_never_binds() -> None:
+    """U15-FU2（残留 B）：两侧都带同一个哨兵时 ``generation_id`` 逐字相等 ≠ 绑定。"""
+    guard = _u15_fu2_binding_guard()
+    sentinel = _sentinel_generation("unknown")
+    real = _sentinel_generation("rt-real-1")
+    # 授权记录里绑定的运行代字段（修前签发侧会把哨兵写进去）——用同一份口径
+    # 造出的两个哨兵运行代，其 generation_id 逐字相等（这正是缺陷的触发条件）。
+    twin = _sentinel_generation("unknown")
+    check("前提：两个哨兵运行代的 generation_id 逐字相等（否则本轮无的放矢）",
+          sentinel.generation_id == twin.generation_id
+          and sentinel.runtime_instance_id == twin.runtime_instance_id,
+          f"{sentinel.generation_id} {twin.generation_id}")
+
+    if guard:
+        both = verify_account_binding(sentinel, twin)
+        check("哨兵×哨兵不通过绑定，原因码 RUNTIME_INSTANCE_UNBOUND（复用既有码）",
+              not both.allowed and _RUNTIME_INSTANCE_UNBOUND in both.reason_codes,
+              both.as_dict())
+        for label, expected_gen, actual_gen in (
+                ("expected 带哨兵", sentinel, real),
+                ("actual 带哨兵", real, sentinel)):
+            mixed = verify_account_binding(expected_gen, actual_gen)
+            check(f"任一侧带哨兵即不通过（{label}）",
+                  not mixed.allowed and _RUNTIME_INSTANCE_UNBOUND in mixed.reason_codes,
+                  mixed.as_dict())
+    else:
+        legacy = verify_account_binding(sentinel, twin)
+        check("基线态：哨兵×哨兵被判「绑定成立」且无原因码（复现缺陷）",
+              legacy.allowed and not legacy.reason_codes, legacy.as_dict())
+
+    # ── 反向证据（两态都成立）：真值与「只是长得像」的值不被误杀 ──
+    check("反向证据：真实运行代照常通过（两态都成立）",
+          verify_account_binding(real, real).allowed
+          and not verify_account_binding(real, real).reason_codes,
+          verify_account_binding(real, real).as_dict())
+    lookalikes = ("unknownverse", "known", "n/a-x", "UNKNOWN-X", "unknown-ish", "tbd-2")
+    bad = [name for name in lookalikes
+           if not verify_account_binding(
+               _sentinel_generation(name, started_at=2000.0),
+               _sentinel_generation(name, started_at=2000.0)).allowed]
+    check("反向证据：只是长得像哨兵的真实例号不被误杀（两态都成立）",
+          not bad, f"被误杀={bad}")
+
+    # ── 既有语义未变（两态都成立）──
+    check("既有语义未变：缺 actual 仍是 RUNTIME_GENERATION_UNPROVEN（逐字不变）",
+          verify_account_binding(real, None).reason_codes
+          == ("RUNTIME_GENERATION_UNPROVEN",))
+    check("既有语义未变：两边都未声明 scope 时不比较（两态都成立）",
+          verify_account_binding(real, real).allowed)
+    check("既有语义未变：轮换凭据后绑定照常通过（两态都成立）",
+          verify_account_binding(
+              real, rotate_credential(real, new_key_fingerprint=None)).allowed)
+    check("既有语义未变：畸形入参仍是 RUNTIME_GENERATION_MALFORMED",
+          verify_account_binding(real, object()).reason_codes
+          == ("RUNTIME_GENERATION_MALFORMED",))
+
+
+def _write_registry(path: Path, *, instance: str, restarts: int = 3) -> dict:
+    """把注册表写成一个**自洽**的运行代记录（generation_id 由真实铸造算出）。"""
+    seed = _sentinel_generation(instance)
+    payload = {
+        "environment": seed.environment, "account_ref": seed.account_ref,
+        "runtime_instance_id": seed.runtime_instance_id,
+        "generation_id": seed.generation_id, "credential_epoch": 0,
+        "key_fingerprint": None, "scope_hash": None, "started_at": 1000.0,
+        "restarts": restarts,
+    }
+    path.write_text(json.dumps(payload), encoding="utf-8")
+    return payload
+
+
+def check_contaminated_registry_reheals_runtime_instance_id() -> None:
+    """U15-FU2（残留 A）：持久化文件里的哨兵实例号 = 「无记录」→ 重新铸造。"""
+    from core.ops.supervision import RunRegistry  # noqa: PLC0415
+
+    guard = _u15_fu2_registry_guard()
+    with tempfile.TemporaryDirectory() as raw:
+        path = Path(raw) / "runtime_generation.json"
+        _write_registry(path, instance="unknown")
+        registry = RunRegistry(path)
+        loaded = registry.load()
+        if guard:
+            check("哨兵 registry 视为无记录：load() -> None（修前读出 'unknown'）",
+                  loaded is None, repr(loaded))
+        else:
+            check("基线态：哨兵 registry 被当成合法既有运行代读入（复现缺陷）",
+                  loaded is not None and loaded.runtime_instance_id == "unknown",
+                  repr(loaded))
+
+        record, _created = registry.load_or_mint(
+            environment="demo", account_ref="demo:acct-a", now=2000.0)
+        if guard:
+            check("重铸出**真实**实例号（32 位 uuid4 hex，不再是哨兵）",
+                  len(record.runtime_instance_id) == 32
+                  and record.runtime_instance_id != "unknown"
+                  and all(c in "0123456789abcdef" for c in record.runtime_instance_id),
+                  repr(record.runtime_instance_id))
+            check("旧运行代未被继承（restarts 归零，不把哨兵当成「同一代」）",
+                  record.restarts == 0, str(record.restarts))
+            on_disk = json.loads(path.read_text(encoding="utf-8"))
+            check("重铸已落盘（再次 load 得到的就是真实实例号）",
+                  on_disk["runtime_instance_id"] == record.runtime_instance_id
+                  and RunRegistry(path).load().runtime_instance_id
+                  == record.runtime_instance_id, repr(on_disk["runtime_instance_id"]))
+        else:
+            check("基线态：load_or_mint 把哨兵当成既有运行代继承下来（复现缺陷）",
+                  record.runtime_instance_id == "unknown", repr(record))
+
+    # ── 反向证据（两态都成立）：真值不被误杀、不被无谓重铸 ──
+    with tempfile.TemporaryDirectory() as raw:
+        path = Path(raw) / "runtime_generation.json"
+        _write_registry(path, instance="rt-persisted-1", restarts=4)
+        registry = RunRegistry(path)
+        check("反向证据：真实实例号照常读入（两态都成立）",
+              registry.load() is not None
+              and registry.load().runtime_instance_id == "rt-persisted-1")
+        record, created = registry.load_or_mint(
+            environment="demo", account_ref="demo:acct-a", now=9999.0)
+        check("反向证据：同一环境/账户沿用同一运行代，不重铸、不新铸（两态都成立）",
+              record.runtime_instance_id == "rt-persisted-1"
+              and not created and record.restarts == 4,
+              f"{record.runtime_instance_id!r} created={created} restarts={record.restarts}")
+
+    with tempfile.TemporaryDirectory() as raw:
+        path = Path(raw) / "runtime_generation.json"
+        _write_registry(path, instance="unknownverse", restarts=1)
+        registry = RunRegistry(path)
+        record, created = registry.load_or_mint(
+            environment="demo", account_ref="demo:acct-a", now=5000.0)
+        check("反向证据：只是长得像哨兵的真实例号不被误杀、不被重铸（两态都成立）",
+              record.runtime_instance_id == "unknownverse" and not created,
+              f"{record.runtime_instance_id!r} created={created}")
+
+
+def _e2e_request(**overrides) -> dict:
+    base = {
+        "action": "REDUCE", "account_ref": "demo:acct-a", "lifecycle_id": "lc-e2e",
+        "position_side": "LONG", "reduce_qty": "0.001",
+        "current_position_qty": "0.01", "requested_net_delta": "0",
+        "environment": "demo", "remove_protection": False,
+    }
+    base.update(overrides)
+    return base
+
+
+def check_contaminated_registry_to_authorization_conclusion() -> None:
+    """U15-FU2 端到端：被污染的 registry → 管理授权结论（残留 A→B 合流）。"""
+    from core.management_authorization import (  # noqa: PLC0415
+        ManagementAuthorizationError,
+        evaluate_management_request,
+        issue_management_authorization,
+        resolve_account_domain,
+    )
+    from core.ops.supervision import RunRegistry  # noqa: PLC0415
+
+    binding_guard = _u15_fu2_binding_guard()
+    registry_guard = _u15_fu2_registry_guard()
+    with tempfile.TemporaryDirectory() as raw:
+        path = Path(raw) / "runtime_generation.json"
+        _write_registry(path, instance="unknown")
+        raw_payload = json.loads(path.read_text(encoding="utf-8"))
+
+        # ① 源头：被污染的 registry 铸出的运行代
+        registry = RunRegistry(path)
+        record, _created = registry.load_or_mint(
+            environment="demo", account_ref="demo:acct-a", now=2000.0)
+        registry_generation = _sentinel_generation(
+            record.runtime_instance_id, started_at=record.started_at or 2000.0)
+        # ② 授权路径（B 的立论点）：**另一条路径**拿到的哨兵运行代 —— 修前已签发
+        #    的在途授权 + 直接由 registry 里那个哨兵字段铸出的运行代。
+        poisoned = mint_runtime_generation(
+            environment=raw_payload["environment"],
+            account_ref=raw_payload["account_ref"],
+            runtime_instance_id=raw_payload["runtime_instance_id"],
+            started_at=raw_payload["started_at"])
+
+        authorized = issue_management_authorization(
+            authorization_id="auth-e2e", generation=registry_generation,
+            lifecycle_id="lc-e2e", position_side="LONG", max_reduce_qty="0.005",
+            position_revision=0, nonce="ne", issued_at_ms=1000, ttl_ms=1000)
+        decision = evaluate_management_request(
+            authorized,
+            request=_e2e_request(runtime_instance_id=registry_generation.runtime_instance_id),
+            now_ms=1010, current_revision=0, generation=registry_generation)
+        if registry_guard:
+            check("端到端①：污染 registry 已自愈 → 授权绑定到**真实**实例号且不新增阻断",
+                  record.runtime_instance_id == registry_generation.runtime_instance_id
+                  and len(record.runtime_instance_id) == 32
+                  and decision.submit_allowed
+                  and _RUNTIME_INSTANCE_UNBOUND not in decision.reason_codes,
+                  f"{record.runtime_instance_id!r} {decision.as_dict()}")
+        else:
+            check("端到端①基线态：registry 的哨兵被继承 → 授权实际绑在占位符上（复现缺陷）",
+                  record.runtime_instance_id == "unknown"
+                  and registry_generation.runtime_instance_id == "unknown"
+                  and decision.submit_allowed
+                  and _RUNTIME_INSTANCE_UNBOUND not in decision.reason_codes,
+                  f"{record.runtime_instance_id!r} {decision.as_dict()}")
+
+        # ③ 哨兵从**别的路径**进来（不经自愈）：修前的在途授权 + 哨兵运行代
+        if binding_guard:
+            try:
+                issue_management_authorization(
+                    authorization_id="auth-poisoned", generation=poisoned,
+                    lifecycle_id="lc-e2e", position_side="LONG",
+                    max_reduce_qty="0.005", position_revision=0, nonce="np",
+                    issued_at_ms=1000, ttl_ms=1000)
+                issuable = True
+            except ManagementAuthorizationError:
+                issuable = False
+            check("端到端②：签发侧不再把哨兵盖成一份「已绑定」的授权",
+                  not issuable)
+            domain = resolve_account_domain(poisoned)
+            check("端到端②：哨兵运行代的账户域显式未绑定",
+                  not domain.bound and _RUNTIME_INSTANCE_UNBOUND in domain.reason_codes,
+                  domain.as_dict())
+            # 重放一份**修前已签发**的授权（字段绑定 = 哨兵），验证消费侧仍拦住。
+            legacy_auth = authorized.model_copy(update={"runtime_instance_id": "unknown"})
+            blocked = evaluate_management_request(
+                legacy_auth, request=_e2e_request(runtime_instance_id="unknown"),
+                now_ms=1010, current_revision=0, generation=poisoned)
+            check("端到端②：污染 registry 铸出的哨兵运行代 → 授权结论为「不通过」"
+                  "且带可区分原因码 RUNTIME_INSTANCE_UNBOUND",
+                  not blocked.submit_allowed
+                  and _RUNTIME_INSTANCE_UNBOUND in blocked.reason_codes,
+                  blocked.as_dict())
+            check("端到端②：按原 id 的收口/查单不被身份绑定阻断（既有边界未变）",
+                  blocked.reconcile_allowed, blocked.as_dict())
+        else:
+            pure_sentinel_auth = issue_management_authorization(
+                authorization_id="auth-poisoned", generation=poisoned,
+                lifecycle_id="lc-e2e", position_side="LONG", max_reduce_qty="0.005",
+                position_revision=0, nonce="np", issued_at_ms=1000, ttl_ms=1000)
+            allowed = evaluate_management_request(
+                pure_sentinel_auth, request=_e2e_request(runtime_instance_id="unknown"),
+                now_ms=1010, current_revision=0, generation=poisoned)
+            check("端到端②基线态：授权绑定在占位符上却判「提交许可」，且无原因码（复现缺陷）",
+                  pure_sentinel_auth.runtime_instance_id == "unknown"
+                  and allowed.submit_allowed and not allowed.binding_reason_codes,
+                  allowed.as_dict())
+
+
 def main() -> int:
