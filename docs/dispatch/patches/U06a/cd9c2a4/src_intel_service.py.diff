+    def _refresh_metrics_summary(self, load_plan: dict[str, Any],
+                                 errors: list[str]) -> dict[str, Any]:
+        """按最小间隔重算汇总指标并缓存；失败如实标 ``UNAVAILABLE``。
+
+        旧实现每轮都全表聚合一次（``intel_observability``），是侧车占用 DB 写锁的
+        主要长查询。这里改为「到期才算 + 缓存复用」，并顺带刷新缺失样本计数。
+
+        Args:
+            load_plan: :func:`shadow_status.research_load_plan` 的结论。
+            errors: 本轮错误列表（就地追加，便于看板显示）。
+
+        Returns:
+            含 ``state``/``age_seconds``/``computed_at`` 的缓存元信息。
+        """
+        if load_plan["allow_metrics"]:
+            self._metrics_attempt_at = time.monotonic()
+            try:
+                self._metrics_cache = dict(self.db.intel_observability())
+                self._metrics_computed_at = datetime.now(timezone.utc).isoformat(
+                    timespec="milliseconds")
+            except Exception as exc:
+                errors.append(f"metrics:{type(exc).__name__}")
+            self._sample_loss = self._sample_loss_by_source()
+        age = self._metrics_age_seconds()
+        if self._metrics_cache is None:
+            state = "UNAVAILABLE"
+            age = None
+        elif load_plan["allow_metrics"]:
+            state = "REFRESHED"
+        else:
+            state = "CACHED"
+        return {"state": state, "age_seconds": age, "computed_at": self._metrics_computed_at,
+                "cached": state == "CACHED", "bounded": True,
+                "min_refresh_seconds": self.metrics_refresh_seconds}
+
+    def _metrics_age_seconds(self) -> float | None:
+        """返回距上次尝试汇总指标的秒数；从未尝试时返回 ``None``。"""
+        if self._metrics_attempt_at is None:
+            return None
+        return round(max(0.0, time.monotonic() - self._metrics_attempt_at), 3)
+
+    def _sample_loss_by_source(self) -> dict[str, Any]:
+        """按来源统计旧口径的标签覆盖率；查询失败如实标 UNAVAILABLE。
+
+        只统计窗口内、方向明确且参考价有效的决策行，与
+        ``evaluate_shadow_decisions`` 的选取口径一致；命中
+        ``idx_shadow_decisions_symbol_time``/主键，不含全表聚合。
+
+        Returns:
+            ``{source: missing_sample_accounting(...)}``。
+        """
+        window = f"-{max(7, int(self.sample_retention_days))} days"
+        out: dict[str, Any] = {}
+        for spec in shadow_status.COHORTS:
+            try:
+                row = self.db.fetch_one(
+                    """SELECT COUNT(*) AS decided,
+                              SUM(CASE WHEN EXISTS(SELECT 1 FROM shadow_outcomes o
+                                                   WHERE o.decision_id=d.decision_id)
+                                       THEN 1 ELSE 0 END) AS labeled
+                       FROM shadow_decisions d
+                       WHERE d.source=? AND d.reference_price>0
+                         AND d.signal IN ('bullish','bearish')
+                         AND datetime(d.created_at)>=datetime('now', ?)""",
+                    (spec.source, window))
+            except Exception as exc:
+                out[spec.source] = shadow_status.missing_sample_accounting(
+                    decided=0, labeled=0, unavailable_reason=type(exc).__name__)
+                continue
+            decided = int(row["decided"] or 0) if row is not None else 0
+            labeled = int(row["labeled"] or 0) if row is not None else 0
+            out[spec.source] = shadow_status.missing_sample_accounting(
+                decided=decided, labeled=labeled)
+        return out
+
