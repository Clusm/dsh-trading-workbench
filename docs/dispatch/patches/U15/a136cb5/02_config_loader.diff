+    def assert_environment_matches_state_root(self, environment: str | None) -> None:
+        """校验 ``environment`` 与状态根是否一致（fail-closed）。
+
+        唯一被拒绝的组合是：``profile_name is None`` 且 ``environment == "live"``
+        —— 此时 ``runtime_path`` 无法把实盘状态锁进 ``data/live``，公共目录会
+        被实盘账本占用（换代码根不改状态根 / 双控制台串账本）。抛
+        ``LiveWithoutProfileStateRootError``（``code`` 为
+        ``LIVE_WITHOUT_PROFILE_STATE_ROOT``），由启动方决定如何终止进程。
+
+        未显式传入 environment、或传入 demo/testnet/paper 时保持现状不改变
+        任何既有行为（存在性触发，缺省即向后兼容）。
+        """
+        text = str(environment or "").strip().lower()[:32]
+        if self.profile_name is None and text == "live":
+            raise LiveWithoutProfileStateRootError(
+                f"{LIVE_WITHOUT_PROFILE_STATE_ROOT}: MTA_PROFILE 未设置但 environment=live，"
+                "实盘状态根无法确定"
+            )
