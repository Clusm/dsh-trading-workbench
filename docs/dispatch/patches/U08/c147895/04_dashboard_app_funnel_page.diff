+            esc(str(item.get("manager") or "")), esc(str(item.get("strategy_id") or "")),
+            esc(str(item.get("rule_version") or "")))
+        for item in (attribution.get("positions") or []) if isinstance(item, dict)
+    ) or "<tr><td colspan='5' class='muted'>当前没有未平仓仓位</td></tr>"
+    if report.get("available"):
+        head = (
