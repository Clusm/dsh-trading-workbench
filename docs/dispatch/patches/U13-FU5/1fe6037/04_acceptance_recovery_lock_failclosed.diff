+def _attempt_code(fn, *args, **kwargs) -> str:
+    """调用 ``fn``；返回异常的 ``code`` 属性（未抛异常则返回空串）。"""
+    try:
+        fn(*args, **kwargs)
+    except BaseException as exc:  # noqa: BLE001 —— 只取原因码，不吞给调用方
+        return str(getattr(exc, "code", "") or type(exc).__name__)
+    return ""
+
