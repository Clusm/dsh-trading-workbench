+def _u15_fu1_guard() -> str:
+    """两态探测：U15-FU1 交付物是否在位（不猜共享文件是否已打补丁）。"""
+    return str(getattr(runtime_identity_module, "U15_FU1_RUNTIME_INSTANCE_GUARD", ""))
