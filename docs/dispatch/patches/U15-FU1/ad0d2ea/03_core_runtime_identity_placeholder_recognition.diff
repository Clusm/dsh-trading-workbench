+# --------------------------------------------------------------------------
+# 运行代占位符（U15-FU1）
+# --------------------------------------------------------------------------
+#: 两态探测标记（U15-FU1 交付物存在性）：验收套件据此对"修前/修后"分别断言，
+#: 不猜共享文件是否已应用补丁。
+U15_FU1_RUNTIME_INSTANCE_GUARD = "U15-FU1"
+
+#: 运行代**占位符**：读起来像一个值，实际**不是**运行代。
+#:
+#: 它们的来源是"上游默认填充"（例如 ``os.getenv("MTA_RUNTIME_INSTANCE_ID",
+#: "unknown")`` 或调用方未提供运行时各自补的字面量）。因为非空字符串，它们能
+#: 一路通过"非空即合法"的检查，进入发布清单的身份证据 —— 使清单**读起来**有
+#: 运行代、实际没有（U15-FU1 / 与 U09-FU1 同族的"读数即值"缺陷）。
+RUNTIME_INSTANCE_PLACEHOLDERS: tuple[str, ...] = (
+    "unknown", "none", "null", "nil", "n/a", "na", "undefined", "unset",
+    "missing", "not-set", "notset", "-", "--", "?", "placeholder", "tbd",
+)
+
+
+def is_placeholder_runtime_instance_id(value: object) -> bool:
+    """宿主占位哨兵判定：仅对**字符串**判定，空/非字符串一律 ``False``。
+
+    空值与形状错误由各入口的**既有**语义处理（``mint_runtime_generation`` /
+    ``collect_runtime_identity`` 一律 ``MissingRuntimeInputError``），本函数
+    只回答一个问题："这个字符串是真的运行代，还是上游补的占位符？"
+    """
+    if not isinstance(value, str):
+        return False
+    return value.strip().casefold() in RUNTIME_INSTANCE_PLACEHOLDERS
+
+
+def resolve_runtime_instance_id(value: object) -> str | None:
+    """归一化为**真实**运行代，或 ``None``（= 缺失）。
+
+    ``None`` / 空串 / 纯空白 / 非字符串 / 占位符 一律返回 ``None``：**绝不**
+    返回哨兵。调用方拿到 ``None`` 时必须显式登记"运行代未证明"，不得用默认
+    值回填（这正是 U15-FU1 修掉的那条路径）。
+    """
+    if is_placeholder_runtime_instance_id(value):
+        return None
+    if not isinstance(value, str) or not value.strip():
+        return None
+    return value.strip()
+
