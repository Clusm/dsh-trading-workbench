+    def log_shadow_v2_statistics(self, rows: Iterable[Mapping[str, Any]], *,
+                                 computed_at: str | None = None) -> int:
+        """幂等写入 U07 的统计快照行；返回本次实际新增行数。
+
+        研究侧边界（DL09）：
+
+        * 只写 ``shadow_v2_statistics``，**不触** ``shadow_decisions``/
+          ``shadow_outcomes``，因此发布门禁的候选/闭合分母都不受影响；
+        * ``counts_toward_release_gate``/``execution_weight``/``auto_promotion``
+          由本层**强制**写死为 0/0.0/0：即便调用方传 True 或非零权重也不生效——
+          统计产物不得经任何路径变成执行或门禁输入；
+        * ``INSERT OR IGNORE`` + 主键含 ``digest``：同一份报告重复写入即 0 新增，
+          改口径必换 digest ⇒ **重放不产生新行**；
+        * 缺 ``digest``/``experiment_key`` 的行被跳过（不拿空键占位）。
+        """
+        moment = str(computed_at or utc_now())
+        payload: list[tuple[Any, ...]] = []
+        for raw in rows:
+            row = dict(raw) if isinstance(raw, Mapping) else {}
+            experiment_key = str(row.get("experiment_key") or "")
+            digest = str(row.get("digest") or "")
+            if not experiment_key or not digest:
+                continue
+            payload.append((
+                experiment_key,
+                str(row.get("report_kind") or "paired_experiment"),
+                str(row.get("config_fingerprint") or ""),
+                digest,
+                moment,
+                str(row.get("schema") or ""),
+                str(row.get("caliber") or ""),
+                json.dumps(row.get("payload") or {}, ensure_ascii=False, default=str),
+                0,  # 强制：统计研究行恒不计入门禁
+                0.0,  # 强制：统计研究行恒无执行权重
+                0,  # 强制：统计研究行恒不自动晋升
+            ))
+        if not payload:
+            return 0
+        with self.lock:
+            before = int(self.conn.execute(
+                "SELECT COUNT(*) FROM shadow_v2_statistics").fetchone()[0])
+            self.conn.executemany(
+                """INSERT OR IGNORE INTO shadow_v2_statistics(
+                   experiment_key,report_kind,config_fingerprint,digest,computed_at,
+                   schema,caliber,payload_json,counts_toward_release_gate,
+                   execution_weight,auto_promotion)
+                   VALUES(?,?,?,?,?,?,?,?,?,?,?)""",
+                payload,
+            )
+            after = int(self.conn.execute(
+                "SELECT COUNT(*) FROM shadow_v2_statistics").fetchone()[0])
+            self.conn.commit()
+        return max(0, after - before)
+
+    def fetch_shadow_v2_statistics(self, *, experiment_key: str | None = None,
+                                   report_kind: str | None = None,
+                                   limit: int = 100) -> list[dict[str, Any]]:
+        """按实验版本/报告类型读取统计快照（只读，仅供研究展示与复验）。"""
+        clauses: list[str] = []
+        params: list[Any] = []
+        if experiment_key:
+            clauses.append("experiment_key=?")
+            params.append(str(experiment_key))
+        if report_kind:
+            clauses.append("report_kind=?")
+            params.append(str(report_kind))
+        sql = "SELECT * FROM shadow_v2_statistics"
+        if clauses:
+            sql += " WHERE " + " AND ".join(clauses)
+        sql += " ORDER BY computed_at DESC, digest LIMIT ?"
+        params.append(max(1, int(limit)))
+        with self.lock:
+            rows = self.conn.execute(sql, tuple(params)).fetchall()
+        out: list[dict[str, Any]] = []
+        for row in rows:
+            item = dict(row)
+            try:
+                item["payload"] = json.loads(item.get("payload_json") or "{}")
+            except (TypeError, ValueError):
+                item["payload"] = {}
+            out.append(item)
+        return out
