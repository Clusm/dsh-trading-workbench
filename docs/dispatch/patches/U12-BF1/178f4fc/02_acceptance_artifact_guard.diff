+        except BaseException as exc:  # noqa: BLE001
+            _hop2 = f"其它异常：{type(exc).__name__}: {exc}"
+        print(f"  ----  [U12-BF1 hop2 / I] hash_artifact(真实工件) -> {_hop2}")
+
+
