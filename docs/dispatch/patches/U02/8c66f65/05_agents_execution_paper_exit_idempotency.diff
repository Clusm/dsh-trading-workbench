+    def _exit_idempotency_guard(self, manager: Any, intent: Any,
+                               existing: tuple[str, dict[str, Any]] | None,
+                               source: str) -> dict[str, Any] | None:
+        """U02：退出先经管理预留做幂等与只减校验。
+
+        返回非 None 表示本次退出**不执行**：重复退出返回 ``duplicate_skipped``，
+        无可减量返回 ``exit_noop``——两者都绝不会被降级成反向开仓（退出方向由
+        持仓侧决定，请求量被可减量夹逼）。纸面成交是同步完成的，因此注册后即
+        释放预留，把仓量让给后续真正的退出。
+        """
+        symbol = str(intent.symbol)
+        _, pos = existing if existing else ("", {})
+        position_side = str(pos.get("side") or getattr(intent, "side", "") or "")
+        exit_key = str(getattr(intent, "client_order_id", None)
+                       or f"paper-exit:{symbol}:{position_side}")
+        domain = f"{str(getattr(self, 'environment', 'paper'))}:{symbol}:{position_side}"
+        outcome = manager.request_exit(
+            exit_key=exit_key, lifecycle_id=domain, symbol=symbol,
+            position_side=position_side, qty=float(getattr(intent, "qty", 0) or 0),
+            current_qty=float(pos.get("qty") or 0.0))
+        if outcome.duplicate:
+            return {"order_id": exit_key, "action": "duplicate_skipped",
+                    "symbol": symbol, "source": source,
+                    "reason_codes": list(outcome.reason_codes)}
+        if not outcome.accepted or outcome.submit_qty <= 0:
+            return {"order_id": exit_key, "action": "exit_noop", "symbol": symbol,
+                    "source": source, "reason_codes": list(outcome.reason_codes)}
+        manager.release_exit(exit_key, reason="paper_immediate_fill")
+        return None
+
