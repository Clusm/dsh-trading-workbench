+        """按环境域读取已入库收入流水；返回 dict 行以适配 ``IncomeEvent`` 校验。"""
+        sql = """SELECT environment,account_ref,income_type,tran_id,symbol,asset,amount,
+                        event_time_ms,received_at_ms,source_hash,content_hash,status
+                 FROM income_events
+                 WHERE environment_norm=? AND account_ref_norm=?"""
+        params: list[Any] = [self._income_norm(environment), self._income_norm(account_ref)]
+        if income_type:
+            sql += " AND income_type_norm=?"
+            params.append(self._income_norm(income_type))
