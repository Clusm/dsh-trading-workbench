+    def insert_income_events(self, rows: Iterable[Mapping[str, Any]]) -> int:
+        """幂等写入收入流水；同幂等四元组已存在则忽略，返回本次实际新增行数。"""
+        inserted = 0
+        with self.lock:
+            for raw in rows:
+                row = self._income_row(raw)
+                cursor = self.conn.execute(
+                    """INSERT OR IGNORE INTO income_events(
+                       environment,account_ref,income_type,tran_id,
+                       environment_norm,account_ref_norm,income_type_norm,tran_id_norm,
+                       symbol,asset,amount,event_time_ms,received_at_ms,source_hash,
+                       content_hash,status,raw_json)
+                       VALUES(?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,'ACTIVE',?)""",
+                    (row["environment"], row["account_ref"],
+                     row["income_type"], row["tran_id"],
+                     self._income_norm(row["environment"]),
+                     self._income_norm(row["account_ref"]),
+                     self._income_norm(row["income_type"]),
+                     self._income_norm(row["tran_id"]),
+                     row["symbol"], row["asset"], row["amount"],
+                     row["event_time_ms"], row["received_at_ms"], row["source_hash"],
+                     self._income_content_hash(row), row["raw_json"]),
+                )
+                if cursor.rowcount == 1:
+                    inserted += 1
+            self.conn.commit()
+        return inserted
