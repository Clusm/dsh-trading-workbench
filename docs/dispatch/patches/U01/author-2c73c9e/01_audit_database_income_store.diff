+    def insert_income_events(self, rows: Any) -> int:
+        """幂等写入收入流水；同 (env,account,type,tran_id) 已存在则忽略，返回新增数。"""
+        inserted = 0
+        with self.lock:
+            for row in rows:
+                from core.contracts import canonical_hash
+                content_hash = str(row.get("content_hash") or canonical_hash({
+                    "environment": str(row["environment"]).lower(),
+                    "account_ref": str(row["account_ref"]),
+                    "income_type": str(row["income_type"]),
+                    "tran_id": str(row["tran_id"]),
+                    "symbol": row.get("symbol") or "",
+                    "asset": str(row.get("asset") or ""),
+                    "amount": str(row.get("amount") or ""),
+                    "event_time_ms": int(row.get("event_time_ms") or 0),
+                }))
+                cursor = self.conn.execute(
+                    """INSERT OR IGNORE INTO income_events(environment,account_ref,income_type,
+                       tran_id,symbol,asset,amount,event_time_ms,received_at_ms,source_hash,
+                       content_hash,status,raw_json)
+                       VALUES(?,?,?,?,?,?,?,?,?,?,?,'ACTIVE',?)""",
+                    (str(row["environment"]).lower(), str(row["account_ref"]),
+                     str(row["income_type"]), str(row["tran_id"]), row.get("symbol") or "",
+                     str(row.get("asset") or "USDT"), str(row.get("amount") or ""),
+                     int(row.get("event_time_ms") or 0), int(row.get("received_at_ms") or 0),
+                     row.get("source_hash"), content_hash, row.get("raw_json")),
+                )
+                if cursor.rowcount == 1:
+                    inserted += 1
+            self.conn.commit()
+        return inserted
+
+    def fetch_income_events(self, *, environment: str, account_ref: str,
+                            income_type: str | None = None) -> list[dict[str, Any]]:
+        """读取已入库收入流水；返回 dict 行以适配 IncomeEvent.model_validate。"""
+        sql = """SELECT environment,account_ref,income_type,tran_id,symbol,asset,amount,
+                        event_time_ms,received_at_ms,source_hash,content_hash,status
+                 FROM income_events WHERE environment=? AND account_ref=?"""
+        params: list[Any] = [str(environment).lower(), str(account_ref)]
+        if income_type:
+            sql += " AND income_type=?"
+            params.append(str(income_type))
+        sql += " ORDER BY event_time_ms ASC, id ASC"
+        return [dict(row) for row in self.fetch_all(sql, tuple(params))]
+
