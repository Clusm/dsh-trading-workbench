{
  "$defs": {
    "AlertDelivery": {
      "additionalProperties": false,
      "description": "一次告警投递尝试；每一级状态只由对应事实支撑。",
      "properties": {
        "ack_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ack At Ms"
        },
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "delivered_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered At Ms"
        },
        "incident_key": {
          "title": "Incident Key",
          "type": "string"
        },
        "provider_receipt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Receipt"
        },
        "receiver_ref": {
          "title": "Receiver Ref",
          "type": "string"
        },
        "schema_version": {
          "default": "3.1",
          "title": "Schema Version",
          "type": "string"
        },
        "state": {
          "default": "UNKNOWN",
          "enum": [
            "UNKNOWN",
            "SUBMITTED",
            "ACCEPTED",
            "DELIVERED",
            "ACKNOWLEDGED"
          ],
          "title": "State",
          "type": "string"
        },
        "submitted_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Submitted At Ms"
        }
      },
      "required": [
        "incident_key",
        "attempt",
        "receiver_ref"
      ],
      "title": "AlertDelivery",
      "type": "object"
    },
    "DecisionCounters": {
      "additionalProperties": false,
      "description": "三类计数器分离；禁止用一个“总次数”代表全部。",
      "properties": {
        "api_attempts_total": {
          "default": 0,
          "title": "Api Attempts Total",
          "type": "integer"
        },
        "cycles_total": {
          "default": 0,
          "title": "Cycles Total",
          "type": "integer"
        },
        "decisions_total": {
          "default": 0,
          "title": "Decisions Total",
          "type": "integer"
        }
      },
      "title": "DecisionCounters",
      "type": "object"
    },
    "DecisionTraceSpan": {
      "additionalProperties": false,
      "description": "单个阶段 span；deadline_remaining 由调用方在单调时钟上计算。",
      "properties": {
        "attempt": {
          "minimum": 1,
          "title": "Attempt",
          "type": "integer"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "deadline_remaining_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deadline Remaining Ms"
        },
        "ended_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ended Ms"
        },
        "purpose": {
          "title": "Purpose",
          "type": "string"
        },
        "reason_code": {
          "default": "",
          "title": "Reason Code",
          "type": "string"
        },
        "request_id": {
          "title": "Request Id",
          "type": "string"
        },
        "schema_version": {
          "default": "3.1",
          "title": "Schema Version",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "started_ms": {
          "title": "Started Ms",
          "type": "integer"
        }
      },
      "required": [
        "cycle_id",
        "stage",
        "request_id",
        "attempt",
        "purpose",
        "started_ms"
      ],
      "title": "DecisionTraceSpan",
      "type": "object"
    },
    "Incident": {
      "additionalProperties": false,
      "description": "稳定 key 的故障事件；ACK 与 RESOLVED 是两种不同事实。",
      "properties": {
        "ack_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ack At Ms"
        },
        "first_seen_ms": {
          "title": "First Seen Ms",
          "type": "integer"
        },
        "incident_key": {
          "title": "Incident Key",
          "type": "string"
        },
        "last_seen_ms": {
          "title": "Last Seen Ms",
          "type": "integer"
        },
        "object_ref": {
          "title": "Object Ref",
          "type": "string"
        },
        "profile": {
          "title": "Profile",
          "type": "string"
        },
        "recovery_predicate": {
          "$ref": "#/$defs/RecoveryPredicate"
        },
        "resolution_evidence_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolution Evidence Hash"
        },
        "resolved_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved At Ms"
        },
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "default": "OPEN",
          "enum": [
            "OPEN",
            "ACK",
            "RESOLVED"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "incident_key",
        "first_seen_ms",
        "last_seen_ms",
        "severity",
        "recovery_predicate",
        "profile",
        "object_ref"
      ],
      "title": "Incident",
      "type": "object"
    },
    "RecoveryCheck": {
      "additionalProperties": false,
      "properties": {
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "recovered": {
          "title": "Recovered",
          "type": "boolean"
        }
      },
      "required": [
        "recovered"
      ],
      "title": "RecoveryCheck",
      "type": "object"
    },
    "RecoveryPredicate": {
      "additionalProperties": false,
      "description": "恢复谓词：必须由新鲜证据满足，而不是缓存里的绿色状态。",
      "properties": {
        "max_age_ms": {
          "exclusiveMinimum": 0,
          "title": "Max Age Ms",
          "type": "integer"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        }
      },
      "required": [
        "required_evidence",
        "max_age_ms"
      ],
      "title": "RecoveryPredicate",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "schema 导出与冒烟校验入口；不是运行期数据结构。",
  "properties": {
    "alert_delivery": {
      "$ref": "#/$defs/AlertDelivery"
    },
    "counters": {
      "$ref": "#/$defs/DecisionCounters"
    },
    "incident": {
      "$ref": "#/$defs/Incident"
    },
    "recovery_check": {
      "$ref": "#/$defs/RecoveryCheck"
    },
    "trace_span": {
      "$ref": "#/$defs/DecisionTraceSpan"
    }
  },
  "required": [
    "trace_span",
    "counters",
    "incident",
    "recovery_check",
    "alert_delivery"
  ],
  "title": "K05SchemaEnvelope",
  "type": "object"
}
