{
  "$defs": {
    "AuthorizationVerdict": {
      "additionalProperties": false,
      "properties": {
        "allowed": {
          "title": "Allowed",
          "type": "boolean"
        },
        "authorization_id": {
          "title": "Authorization Id",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "authorization_id",
        "allowed"
      ],
      "title": "AuthorizationVerdict",
      "type": "object"
    },
    "ManagementAuthorization": {
      "additionalProperties": false,
      "description": "管理能力凭证；绑定账户、仓位、数量、保护目标与时效。",
      "properties": {
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "authorization_id": {
          "title": "Authorization Id",
          "type": "string"
        },
        "expires_at_ms": {
          "title": "Expires At Ms",
          "type": "integer"
        },
        "issued_at_ms": {
          "title": "Issued At Ms",
          "type": "integer"
        },
        "lifecycle_id": {
          "title": "Lifecycle Id",
          "type": "string"
        },
        "max_reduce_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Reduce Qty"
        },
        "nonce": {
          "title": "Nonce",
          "type": "string"
        },
        "position_revision": {
          "minimum": 0,
          "title": "Position Revision",
          "type": "integer"
        },
        "position_side": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Position Side",
          "type": "string"
        },
        "target_protection": {
          "$ref": "#/$defs/ProtectionTarget"
        }
      },
      "required": [
        "authorization_id",
        "account_ref",
        "lifecycle_id",
        "position_side",
        "max_reduce_qty",
        "target_protection",
        "position_revision",
        "nonce",
        "issued_at_ms",
        "expires_at_ms"
      ],
      "title": "ManagementAuthorization",
      "type": "object"
    },
    "ManagementIntent": {
      "additionalProperties": false,
      "description": "有界管理意图；OPEN 不属于管理动作，不能出现在此契约。",
      "properties": {
        "action": {
          "enum": [
            "CLOSE",
            "REDUCE",
            "MAINTAIN_PROTECTION"
          ],
          "title": "Action",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "expires_at_ms": {
          "title": "Expires At Ms",
          "type": "integer"
        },
        "identity": {
          "$ref": "#/$defs/RuntimeIdentity"
        },
        "lifecycle_id": {
          "title": "Lifecycle Id",
          "type": "string"
        },
        "management_id": {
          "title": "Management Id",
          "type": "string"
        },
        "max_reduce_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Max Reduce Qty"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "position_revision": {
          "minimum": 0,
          "title": "Position Revision",
          "type": "integer"
        },
        "position_side": {
          "enum": [
            "LONG",
            "SHORT"
          ],
          "title": "Position Side",
          "type": "string"
        },
        "reason_code": {
          "title": "Reason Code",
          "type": "string"
        },
        "schema_version": {
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "trigger_event_id": {
          "title": "Trigger Event Id",
          "type": "string"
        },
        "trigger_type": {
          "title": "Trigger Type",
          "type": "string"
        }
      },
      "required": [
        "management_id",
        "identity",
        "lifecycle_id",
        "position_side",
        "action",
        "max_reduce_qty",
        "position_revision",
        "reason_code",
        "policy_version",
        "expires_at_ms",
        "evidence_id",
        "trigger_type",
        "trigger_event_id"
      ],
      "title": "ManagementIntent",
      "type": "object"
    },
    "OrderQuantity": {
      "additionalProperties": false,
      "description": "订单数量的三个分量与状态规则；终态后迟到 fill 只改事实不复活订单。",
      "properties": {
        "accepted_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Accepted Qty"
        },
        "cancel_confirmed": {
          "default": false,
          "title": "Cancel Confirmed",
          "type": "boolean"
        },
        "cancel_requested": {
          "default": false,
          "title": "Cancel Requested",
          "type": "boolean"
        },
        "cumulative_filled_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Cumulative Filled Qty"
        },
        "order_id": {
          "title": "Order Id",
          "type": "string"
        },
        "revision": {
          "default": 0,
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "status": {
          "enum": [
            "NEW",
            "PARTIALLY_FILLED",
            "FILLED",
            "CANCELED",
            "EXPIRED",
            "REJECTED"
          ],
          "title": "Status",
          "type": "string"
        },
        "terminal_unfilled_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Terminal Unfilled Qty"
        },
        "working_leaves_qty": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Working Leaves Qty"
        }
      },
      "required": [
        "order_id",
        "accepted_qty",
        "cumulative_filled_qty",
        "working_leaves_qty",
        "terminal_unfilled_qty",
        "status"
      ],
      "title": "OrderQuantity",
      "type": "object"
    },
    "ProtectionTarget": {
      "additionalProperties": false,
      "description": "授权绑定的目标保护单；last_protection 标记用于拒绝撤最后保护。",
      "properties": {
        "is_last_protection": {
          "default": false,
          "title": "Is Last Protection",
          "type": "boolean"
        },
        "sl_client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sl Client Id"
        },
        "tp_client_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tp Client Id"
        }
      },
      "title": "ProtectionTarget",
      "type": "object"
    },
    "RuntimeIdentity": {
      "additionalProperties": false,
      "description": "一次运行的不可混淆身份；不得写入原始密钥或完整 .env。",
      "properties": {
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "artifact_hash": {
          "title": "Artifact Hash",
          "type": "string"
        },
        "dependency_hash": {
          "title": "Dependency Hash",
          "type": "string"
        },
        "effective_config_hash": {
          "title": "Effective Config Hash",
          "type": "string"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "git_commit": {
          "title": "Git Commit",
          "type": "string"
        },
        "model_route_hash": {
          "title": "Model Route Hash",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "schema_version": {
          "default": "3.0",
          "title": "Schema Version",
          "type": "string"
        },
        "strategy_hash": {
          "title": "Strategy Hash",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "account_ref",
        "artifact_hash",
        "git_commit",
        "dependency_hash",
        "effective_config_hash",
        "strategy_hash",
        "model_route_hash",
        "runtime_instance_id"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "schema 导出与冒烟校验入口；不是运行期数据结构。",
  "properties": {
    "authorization": {
      "$ref": "#/$defs/ManagementAuthorization"
    },
    "authorization_verdict": {
      "$ref": "#/$defs/AuthorizationVerdict"
    },
    "management_intent": {
      "$ref": "#/$defs/ManagementIntent"
    },
    "order_quantity": {
      "$ref": "#/$defs/OrderQuantity"
    }
  },
  "required": [
    "management_intent",
    "authorization",
    "authorization_verdict",
    "order_quantity"
  ],
  "title": "K04SchemaEnvelope",
  "type": "object"
}
