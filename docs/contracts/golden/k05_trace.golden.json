{
  "contract": "K05",
  "title": "决策轨迹/事件/告警投递正反 golden",
  "version": "v3.0",
  "independent": true,
  "cases": [
    {
      "case_id": "K05-P1",
      "kind": "positive",
      "title": "恢复证据新鲜满足谓词→RESOLVED 且记录证据哈希",
      "operation": "k05_incident_recovery",
      "derivation": "规格 §4 K05：ACK 只是确认看到，RESOLVED 必须满足恢复证据。证据时间 1789862400000 距 now=1789862401000 仅 1 秒，不超过 max_age_ms=90000，且 value=true；恢复成立后状态 RESOLVED 并写入 resolution_evidence_hash（规范化 JSON 的 sha256）。",
      "inputs": {
        "now_ms": 1789862401000,
        "ack": true,
        "incident": {
          "incident_key": "demo|account_snapshot|EVIDENCE_STALE",
          "first_seen_ms": 1789860000000,
          "last_seen_ms": 1789860300000,
          "severity": "WARNING",
          "status": "OPEN",
          "recovery_predicate": {"required_evidence": ["fresh_account_snapshot"], "max_age_ms": 90000},
          "profile": "demo",
          "object_ref": "account_snapshot"
        },
        "evidence": {
          "fresh_account_snapshot": {"observed_at_ms": 1789862400000, "value": true}
        }
      },
      "expect": {
        "recovered": true,
        "reason_codes": [],
        "resolve_error": null,
        "status": "RESOLVED",
        "evidence_hash_present": true
      }
    },
    {
      "case_id": "K05-P2",
      "kind": "positive",
      "title": "HTTP200 已提交但无回执→SUBMITTED 不是 DELIVERED",
      "operation": "k05_delivery",
      "derivation": "规格 §11.2：HTTP 成功、供应商接收、设备送达、人确认分开记录。仅 submitted_at_ms 有值（HTTP 200），无 provider_receipt、无 delivered_at、无 ack→最高可信状态 SUBMITTED；声明 SUBMITTED 与事实一致，无违规。",
      "inputs": {
        "delivery": {
          "incident_key": "demo|account_snapshot|EVIDENCE_STALE",
          "attempt": 1,
          "receiver_ref": "ops-fake-sink",
          "provider_receipt": null,
          "submitted_at_ms": 1789860300000,
          "delivered_at_ms": null,
          "ack_at_ms": null,
          "state": "SUBMITTED"
        }
      },
      "expect": {"derived_state": "SUBMITTED", "violations": []}
    },
    {
      "case_id": "K05-P3",
      "kind": "positive",
      "title": "人确认→ACKNOWLEDGED，不伪造设备送达",
      "operation": "k05_delivery",
      "derivation": "规格 §11.2：通道不能提供设备送达回执时，允许以可审计的人类确认验证端到端演练；状态标为 ACKNOWLEDGED 而非伪造 DELIVERED。样本有 provider_receipt 与 ack_at、无 delivered_at；声明 ACKNOWLEDGED 与事实一致。",
      "inputs": {
        "delivery": {
          "incident_key": "demo|account_snapshot|EVIDENCE_STALE",
          "attempt": 2,
          "receiver_ref": "ops-oncall",
          "provider_receipt": "receipt-synth-1",
          "submitted_at_ms": 1789860300000,
          "delivered_at_ms": null,
          "ack_at_ms": 1789860900000,
          "state": "ACKNOWLEDGED"
        }
      },
      "expect": {"derived_state": "ACKNOWLEDGED", "violations": []}
    },
