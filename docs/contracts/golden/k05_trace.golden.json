      "inputs": {
        "spans": [
          {"cycle_id": "cyc-1", "stage": "cycle_start", "request_id": "req-c1", "attempt": 1, "purpose": "cycle", "started_ms": 1789862400000, "ended_ms": 1789862400100},
          {"cycle_id": "cyc-1", "stage": "research", "request_id": "req-a1", "attempt": 1, "purpose": "api_attempt", "started_ms": 1789862400100, "ended_ms": 1789862400200, "deadline_remaining_ms": 230000},
          {"cycle_id": "cyc-1", "stage": "research", "request_id": "req-a2", "attempt": 2, "purpose": "api_attempt", "started_ms": 1789862400200, "ended_ms": 1789862400300},
          {"cycle_id": "cyc-1", "stage": "tool", "request_id": "req-t1", "attempt": 1, "purpose": "tool_call", "started_ms": 1789862400300, "ended_ms": 1789862400350},
          {"cycle_id": "cyc-1", "stage": "submit", "request_id": "req-d1", "attempt": 1, "purpose": "decision", "started_ms": 1789862400350, "ended_ms": 1789862400400},
          {"cycle_id": "cyc-1", "stage": "validate", "request_id": "req-v1", "attempt": 1, "purpose": "validation", "started_ms": 1789862400400, "ended_ms": 1789862400450}
