    {
      "case_id": "K05-P5",
      "kind": "positive",
      "title": "Incident key 跨轮稳定且随对象变化",
      "operation": "k05_incident_key",
      "derivation": "规格 §4 K05：Incident 带稳定 key。key=demo|account_snapshot|EVIDENCE_STALE 对相同 profile/对象/原因必相同；对象变为 protection_missing 后必须不同，避免不同故障被合并或抖动拆成多条。",
      "inputs": {
        "a": {"profile": "demo", "object_ref": "account_snapshot", "reason_code": "EVIDENCE_STALE"},
        "b": {"profile": "demo", "object_ref": "account_snapshot", "reason_code": "EVIDENCE_STALE"},
        "c": {"profile": "demo", "object_ref": "protection_missing", "reason_code": "PROTECTION_MISSING"}
      },
      "expect": {
        "key_a": "demo|account_snapshot|EVIDENCE_STALE",
        "key_b": "demo|account_snapshot|EVIDENCE_STALE",
        "stable": true,
        "distinct_on_object_change": true
      }
    },
    {
      "case_id": "K05-N1",
      "kind": "negative",
