      "inputs": {
        "now_ms": 1789862401000,
        "ack": true,
        "incident": {
          "incident_key": "demo|account_snapshot|EVIDENCE_STALE",
          "first_seen_ms": 1789860000000,
          "last_seen_ms": 1789860300000,
          "severity": "WARNING",
          "status": "OPEN",
          "recovery_predicate": {"required_evidence": ["fresh_account_snapshot"], "max_age_ms": 90000},
          "profile": "demo",
          "object_ref": "account_snapshot"
        },
        "evidence": {}
      },
      "expect": {
        "recovered": false,
        "reason_codes": ["EVIDENCE_MISSING"],
        "resolve_error": "ResolutionNotAllowedError",
        "status": "ACK",
        "evidence_hash_present": false
      }
    },
    {
      "case_id": "K05-N2",
      "kind": "negative",
      "title": "声明 DELIVERED 但只有 HTTP 提交事实→拒绝",
      "operation": "k05_delivery",
      "derivation": "F12/F22：HTTP200 未送达不得显示 delivered；通道不支持送达回执就不能伪造 DELIVERED。事实只有 submitted_at_ms，声明 DELIVERED 时：无 delivered_at_ms→DELIVERED_WITHOUT_DEVICE_RECEIPT；无 provider_receipt→PROVIDER_RECEIPT_MISSING；声明状态与事实推导不一致→STATE_MISMATCH。",
      "inputs": {
        "delivery": {
          "incident_key": "demo|account_snapshot|EVIDENCE_STALE",
          "attempt": 1,
          "receiver_ref": "ops-fake-sink",
          "provider_receipt": null,
          "submitted_at_ms": 1789860300000,
          "delivered_at_ms": null,
          "ack_at_ms": null,
          "state": "DELIVERED"
        }
      },
      "expect": {
        "derived_state": "SUBMITTED",
        "violations": [
          "STATE_MISMATCH",
          "DELIVERED_WITHOUT_DEVICE_RECEIPT",
          "PROVIDER_RECEIPT_MISSING"
        ]
      }
    },
