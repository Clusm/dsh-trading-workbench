      "title": "恢复证据新鲜满足谓词→RESOLVED 且记录证据哈希",
      "operation": "k05_incident_recovery",
      "derivation": "规格 §4 K05：ACK 只是确认看到，RESOLVED 必须满足恢复证据；§10.3 要求恢复谓词依赖新鲜证据。证据是 ACK 之后重新观察的（observed_at=1789862401000 等于 ack 时刻且不早于它），距 now 仅 0ms，远小于 max_age_ms=90000，且 value 为显式布尔 true；恢复成立后状态 RESOLVED 并写入 resolution_evidence_hash（规范化 JSON 的 sha256）。",
      "inputs": {
        "now_ms": 1789862401000,
        "ack": true,
        "incident": {
          "incident_key": "demo|account_snapshot|EVIDENCE_STALE",
          "first_seen_ms": 1789860000000,
          "last_seen_ms": 1789860300000,
          "severity": "WARNING",
          "status": "OPEN",
          "recovery_predicate": {"required_evidence": ["fresh_account_snapshot"], "max_age_ms": 90000},
          "profile": "demo",
          "object_ref": "account_snapshot"
        },
        "evidence": {
          "fresh_account_snapshot": {"observed_at_ms": 1789862401000, "value": true}
        }
      },
      "expect": {
        "recovered": true,
        "reason_codes": [],
        "resolve_error": null,
        "status": "RESOLVED",
        "evidence_hash_present": true
      }
    },
