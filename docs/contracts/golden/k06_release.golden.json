      "expect": {
        "statuses": {"engineering": "FAIL"},
        "blocking_codes": [{"group": "engineering", "code": "WINDOW_INVALID"}],
        "extra_top_level_fields": []
      }
    },
    {
      "case_id": "K06-N6",
      "kind": "negative",
      "title": "未知声明状态降级为 NO_DATA",
      "operation": "k06_groups",
      "derivation": "K06 只认 PASS/FAIL/NO_DATA；未知状态不得被当作 PASS，也不能让报告崩溃，必须 NO_DATA + DECLARED_STATUS_UNKNOWN 阻断项。",
      "inputs": {
