{
  "contract": "K06",
  "title": "ReleaseEvidence 五组状态正反 golden",
  "version": "v3.0",
  "independent": true,
  "cases": [
    {
      "case_id": "K06-P1",
      "kind": "positive",
      "title": "五组独立评估：一组 FAIL 不影响其余组",
      "operation": "k06_groups",
      "derivation": "规格 §4 K06：输出五组状态，每组独立。engineering/runtime_observation/strategy_evaluation 证据完整（hash+窗口+身份）→PASS；accounting 声明 FAIL→FAIL 并产生 GROUP_FAILED 阻断项；operations 无证据→NO_DATA+MISSING_EVIDENCE。PASS 组不得因其他组 FAIL 被降级，报告也不产生整体 GO 字段。",
      "inputs": {
        "identity_ref": "demo:rel-synth-1",
        "groups": {
          "engineering": {
            "status": "PASS",
            "evidence_hash": "hash-eng-synth",
            "window_start_ms": 1789776000000,
            "window_end_ms": 1789862400000,
            "identity_ref": "demo:rel-synth-1"
          },
          "accounting": {"status": "FAIL", "detail": "cost coverage incomplete"},
          "runtime_observation": {
            "status": "PASS",
            "evidence_hash": "hash-obs-synth",
            "window_start_ms": 1789776000000,
            "window_end_ms": 1789862400000,
            "identity_ref": "demo:rel-synth-1"
          },
          "operations": null,
          "strategy_evaluation": {
            "status": "PASS",
            "evidence_hash": "hash-strat-synth",
            "window_start_ms": 1789776000000,
            "window_end_ms": 1789862400000,
            "identity_ref": "demo:rel-synth-1"
          }
        }
      },
      "expect": {
        "statuses": {
          "engineering": "PASS",
          "accounting": "FAIL",
          "runtime_observation": "PASS",
          "operations": "NO_DATA",
          "strategy_evaluation": "PASS"
        },
        "blocking_codes": [
          {"group": "accounting", "code": "GROUP_FAILED"},
          {"group": "operations", "code": "MISSING_EVIDENCE"}
        ],
        "extra_top_level_fields": []
      }
    },
    {
      "case_id": "K06-N1",
      "kind": "negative",
      "title": "NO_DATA 不等于 PASS",
      "operation": "k06_groups",
      "derivation": "规格 §4 K06 与 F24：缺数据不得写 PASS。engineering 无证据载荷时必须 NO_DATA 并列出 MISSING_EVIDENCE 阻断项，绝不能因“未发现失败”而显示 PASS。",
      "inputs": {
        "identity_ref": "demo:rel-synth-1",
        "focus_groups": ["engineering"],
        "groups": {"engineering": null}
      },
      "expect": {
        "statuses": {"engineering": "NO_DATA"},
        "blocking_codes": [{"group": "engineering", "code": "MISSING_EVIDENCE"}],
        "extra_top_level_fields": []
      }
    },
    {
      "case_id": "K06-N2",
      "kind": "negative",
      "title": "声明 PASS 但证据不完整→FAIL 并列阻断项",
      "operation": "k06_groups",
      "derivation": "PASS 必须同时具备证据 hash、有效窗口与身份引用（规格 §4 K06 要求每组带证据hash、窗口和身份）。样本只有 evidence_hash，缺窗口与身份：不得降级为 NO_DATA 掩盖，必须 FAIL 并逐项列出阻断原因。",
      "inputs": {
        "identity_ref": "demo:rel-synth-1",
        "focus_groups": ["engineering"],
        "groups": {
          "engineering": {
            "status": "PASS",
            "evidence_hash": "hash-eng-synth",
            "window_start_ms": null,
            "window_end_ms": null,
            "identity_ref": null
          }
        }
      },
      "expect": {
        "statuses": {"engineering": "FAIL"},
        "blocking_codes": [
          {"group": "engineering", "code": "PASS_WITHOUT_EVIDENCE"},
          {"group": "engineering", "code": "WINDOW_MISSING"},
          {"group": "engineering", "code": "IDENTITY_REF_MISSING"}
        ],
        "extra_top_level_fields": []
      }
    },
    {
      "case_id": "K06-N3",
      "kind": "negative",
      "title": "窗口倒置的 PASS 证据被拒绝",
      "operation": "k06_groups",
