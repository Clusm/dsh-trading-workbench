        "b": {"lifecycle_id": "lc-1", "trigger_type": "time_stop", "policy_version": "policy-v3", "trigger_event_id": "evt-1"},
        "c": {"lifecycle_id": "lc-1", "trigger_type": "time_stop", "policy_version": "policy-v3", "trigger_event_id": "evt-2"}
