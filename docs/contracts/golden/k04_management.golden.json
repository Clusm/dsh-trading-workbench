{
  "contract": "K04",
  "title": "管理意图/授权与数量三分量正反 golden",
  "version": "v3.0",
  "independent": true,
  "cases": [
    {
      "case_id": "K04-P1",
      "kind": "positive",
      "title": "三分量守恒：NEW/PARTIALLY_FILLED/CANCELED/FILLED",
      "operation": "k04_quantity",
      "derivation": "规格 §4 K04：accepted = cumulative_filled + working_leaves + terminal_unfilled。NEW/PARTIALLY_FILLED 的 terminal 必须为 0；终态的 working 必须为 0；状态与累计成交必须一致（NEW 不得已有成交、PARTIALLY_FILLED 必须 0<filled<accepted）。四个样本逐项手工核对：10=2.5+7.5+0、1=0.0047+0.9953+0、1=0.0047+0+0.9953、1=1+0+0。",
      "inputs": {
        "quantities": [
          {"order_id": "ord-1", "accepted_qty": "10", "cumulative_filled_qty": "2.5", "working_leaves_qty": "7.5", "terminal_unfilled_qty": "0", "status": "PARTIALLY_FILLED", "revision": 2, "cancel_requested": false, "cancel_confirmed": false},
          {"order_id": "ord-2", "accepted_qty": "1", "cumulative_filled_qty": "0.0047", "working_leaves_qty": "0.9953", "terminal_unfilled_qty": "0", "status": "PARTIALLY_FILLED", "revision": 1, "cancel_requested": false, "cancel_confirmed": false},
          {"order_id": "ord-3", "accepted_qty": "1", "cumulative_filled_qty": "0.0047", "working_leaves_qty": "0", "terminal_unfilled_qty": "0.9953", "status": "CANCELED", "revision": 5, "cancel_requested": true, "cancel_confirmed": true},
          {"order_id": "ord-4", "accepted_qty": "1", "cumulative_filled_qty": "1", "working_leaves_qty": "0", "terminal_unfilled_qty": "0", "status": "FILLED", "revision": 6, "cancel_requested": false, "cancel_confirmed": false}
        ]
      },
      "expect": {"violations": [[], [], [], []]}
    },
    {
      "case_id": "K04-P2",
      "kind": "positive",
      "title": "终态 CANCELED 的迟到 fill 修订累计成交事实",
      "operation": "k04_late_fill",
      "derivation": "规格 §4 K04：迟到 fill 可修正终态的累计成交事实，即使状态仍 CANCELED，也不得因“终态不可回退”丢成交。手工计算 0.0047+0.001=0.0057；终态剩余 0.0053-0.001=0.0043；accepted 0.01=0.0057+0+0.0043；revision 递增到 5。",
      "inputs": {
        "quantity": {
          "order_id": "ord-synth-1",
          "accepted_qty": "0.01",
          "cumulative_filled_qty": "0.0047",
          "working_leaves_qty": "0",
          "terminal_unfilled_qty": "0.0053",
          "status": "CANCELED",
          "revision": 4,
          "cancel_requested": true,
          "cancel_confirmed": true
        },
        "fill_qty": "0.001"
      },
      "expect": {
        "order_id": "ord-synth-1",
        "status": "CANCELED",
        "revision": 5,
        "accepted_qty": "0.01",
        "cumulative_filled_qty": "0.0057",
        "working_leaves_qty": "0",
        "terminal_unfilled_qty": "0.0043",
        "violations": []
      }
    },
    {
      "case_id": "K04-P3",
      "kind": "positive",
      "title": "幂等键跨轮稳定且随触发事件变化",
      "operation": "k04_idempotency",
      "derivation": "规格 §4 K04：幂等键由生命周期、触发类型、规则版本、触发事件确定，不得每轮随机换ID。a/b 输入相同→同一键与同一 management_id；c 仅触发事件不同→键与 id 必须不同，避免把新事件误判成旧意图。",
      "inputs": {
