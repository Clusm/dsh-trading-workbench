{
  "$defs": {
    "BundleVerdict": {
      "additionalProperties": false,
      "description": "证据包完整性结论；content_hash 与事实溯源的可校验入口。",
      "properties": {
        "valid": {
          "title": "Valid",
          "type": "boolean"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        }
      },
      "required": [
        "valid"
      ],
      "title": "BundleVerdict",
      "type": "object"
    },
    "ClaimResult": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "expr": {
          "title": "Expr",
          "type": "string"
        },
        "expected": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expected"
        },
        "actual": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "UNRESOLVED"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_code": {
          "default": "",
          "title": "Reason Code",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "expr",
        "status"
      ],
      "title": "ClaimResult",
      "type": "object"
    },
    "DerivedFact": {
      "additionalProperties": false,
      "description": "由代码计算的派生事实；必须引用至少一个输入 ID。",
      "properties": {
        "fact_id": {
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "value": {
          "title": "Value",
          "type": "string"
        },
        "computed_by": {
          "const": "code",
          "default": "code",
          "title": "Computed By",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "value"
      ],
      "title": "DerivedFact",
      "type": "object"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "description": "一次周期内单币种的证据快照；content_hash 自绑定。",
      "properties": {
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "cycle_id": {
          "title": "Cycle Id",
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/RuntimeIdentity"
        },
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "as_of_ms": {
          "title": "As Of Ms",
          "type": "integer"
        },
        "bar_times": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Bar Times",
          "type": "object"
        },
        "finality": {
          "default": "unknown",
          "enum": [
            "closed",
            "live",
            "unknown"
          ],
          "title": "Finality",
          "type": "string"
        },
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/$defs/EvidenceInput"
          },
          "title": "Inputs",
          "type": "array"
        },
        "dropped_input_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Dropped Input Ids",
          "type": "array"
        },
        "derived_facts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/DerivedFact"
          },
          "title": "Derived Facts",
          "type": "array"
        },
        "quality": {
          "additionalProperties": true,
          "title": "Quality",
          "type": "object"
        },
        "expires_at_ms": {
          "default": 0,
          "title": "Expires At Ms",
          "type": "integer"
        },
        "content_hash": {
          "default": "",
          "title": "Content Hash",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "cycle_id",
        "identity",
        "symbol",
        "as_of_ms"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "EvidenceInput": {
      "additionalProperties": false,
      "description": "单个证据输入；value_ref 指向可复核的原始载荷。",
      "properties": {
        "input_id": {
          "title": "Input Id",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "event_time_ms": {
          "title": "Event Time Ms",
          "type": "integer"
        },
        "received_time_ms": {
          "title": "Received Time Ms",
          "type": "integer"
        },
        "valid_until_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Valid Until Ms"
        },
        "value_ref": {
          "title": "Value Ref",
          "type": "string"
        },
        "symbol": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Symbol"
        },
        "interval": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interval"
        },
        "finality": {
          "default": "unknown",
          "enum": [
            "closed",
            "live",
            "unknown"
          ],
          "title": "Finality",
          "type": "string"
        },
        "bar_close_time_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bar Close Time Ms"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        }
      },
      "required": [
        "input_id",
        "source",
        "event_time_ms",
        "received_time_ms",
        "value_ref"
      ],
      "title": "EvidenceInput",
      "type": "object"
    },
    "EvidenceVerdict": {
      "additionalProperties": false,
      "description": "单个 intent 的校验结论；绑定 intent/symbol/evidence 三元组。",
      "properties": {
        "verdict_id": {
          "default": "",
          "title": "Verdict Id",
          "type": "string"
        },
        "checked_intent_id": {
          "title": "Checked Intent Id",
          "type": "string"
        },
        "intent_symbol": {
          "title": "Intent Symbol",
          "type": "string"
        },
        "evidence_id": {
          "title": "Evidence Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "VALID",
            "EVIDENCE_INVALID",
            "EXPIRED",
            "STALE",
            "SYMBOL_MISMATCH"
          ],
          "title": "Status",
          "type": "string"
        },
        "reason_codes": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Reason Codes",
          "type": "array"
        },
        "claim_results": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ClaimResult"
          },
          "title": "Claim Results",
          "type": "array"
        },
        "checked_at_ms": {
          "title": "Checked At Ms",
          "type": "integer"
        }
      },
      "required": [
        "checked_intent_id",
        "intent_symbol",
        "evidence_id",
        "status",
        "checked_at_ms"
      ],
      "title": "EvidenceVerdict",
      "type": "object"
    },
    "ExecutionQuote": {
      "additionalProperties": false,
      "description": "执行前候选入场报价；OPEN 意图必须携带且有限、未过期。",
      "properties": {
        "symbol": {
          "title": "Symbol",
          "type": "string"
        },
        "price": {
          "title": "Price",
          "type": "string"
        },
        "quote_time_ms": {
          "title": "Quote Time Ms",
          "type": "integer"
        },
        "expires_at_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expires At Ms"
        }
      },
      "required": [
        "symbol",
        "price",
        "quote_time_ms"
      ],
      "title": "ExecutionQuote",
      "type": "object"
    },
    "RuntimeIdentity": {
      "additionalProperties": false,
      "description": "一次运行的不可混淆身份；不得写入原始密钥或完整 .env。",
      "properties": {
        "schema_version": {
          "default": "3.1",
          "title": "Schema Version",
          "type": "string"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "artifact_hash": {
          "title": "Artifact Hash",
          "type": "string"
        },
        "git_commit": {
          "title": "Git Commit",
          "type": "string"
        },
        "dependency_hash": {
          "title": "Dependency Hash",
          "type": "string"
        },
        "effective_config_hash": {
          "title": "Effective Config Hash",
          "type": "string"
        },
        "strategy_hash": {
          "title": "Strategy Hash",
          "type": "string"
        },
        "model_route_hash": {
          "title": "Model Route Hash",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "account_ref",
        "artifact_hash",
        "git_commit",
        "dependency_hash",
        "effective_config_hash",
        "strategy_hash",
        "model_route_hash",
        "runtime_instance_id"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "schema 导出与冒烟校验入口；不是运行期数据结构。",
  "properties": {
    "bundle": {
      "$ref": "#/$defs/EvidenceBundle"
    },
    "verdict": {
      "$ref": "#/$defs/EvidenceVerdict"
    },
    "bundle_verdict": {
      "$ref": "#/$defs/BundleVerdict"
    },
    "claim_result": {
      "$ref": "#/$defs/ClaimResult"
    },
    "execution_quote": {
      "$ref": "#/$defs/ExecutionQuote"
    }
  },
  "required": [
    "bundle",
    "verdict",
    "bundle_verdict",
    "claim_result",
    "execution_quote"
  ],
  "title": "K02SchemaEnvelope",
  "type": "object"
}
