      "description": "一次运行的不可混淆身份；不得写入原始密钥或完整 .env。",
      "properties": {
        "account_ref": {
          "title": "Account Ref",
          "type": "string"
        },
        "artifact_hash": {
          "title": "Artifact Hash",
          "type": "string"
        },
        "dependency_hash": {
          "title": "Dependency Hash",
          "type": "string"
        },
        "effective_config_hash": {
          "title": "Effective Config Hash",
          "type": "string"
        },
        "environment": {
          "title": "Environment",
          "type": "string"
        },
        "git_commit": {
          "title": "Git Commit",
          "type": "string"
        },
        "model_route_hash": {
          "title": "Model Route Hash",
          "type": "string"
        },
        "runtime_instance_id": {
          "title": "Runtime Instance Id",
          "type": "string"
        },
        "schema_version": {
          "default": "3.0",
