        },
        "strategy_hash": {
          "title": "Strategy Hash",
          "type": "string"
        }
      },
      "required": [
        "environment",
        "account_ref",
        "artifact_hash",
        "git_commit",
        "dependency_hash",
        "effective_config_hash",
        "strategy_hash",
        "model_route_hash",
        "runtime_instance_id"
      ],
      "title": "RuntimeIdentity",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "schema 导出与冒烟校验入口；不是运行期数据结构。",
  "properties": {
    "runtime_identity": {
      "$ref": "#/$defs/RuntimeIdentity"
    }
  },
  "required": [
    "runtime_identity"
  ],
  "title": "K01SchemaEnvelope",
  "type": "object"
}
