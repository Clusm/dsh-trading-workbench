# 可选 OpenCode Zen 备用链路；默认关闭，只在主决策的容量/网络故障时接管。
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=union-alpha
MTA_AI_DECISION_FALLBACK_PROVIDER=

# 可选：商汤日日新 OpenAI 兼容接口。本机实际值建议写入 .env.local。
SENSENOVA_API_KEY=
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=deepseek-v4-flash

# 执行环境：paper / demo / testnet / live
# 也可在控制台右上角下拉切换（保存到此处，重启生效）
EXECUTION_MODE=demo

# Binance Demo Trading（主网真实行情 + 虚拟资金，推荐）
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# 传统测试网（模拟行情）
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# 实盘（真实资金！未配置 Key 时控制台会拒绝切换到 live）
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=

# Tavily 网页搜索（可选）
TAVILY_API_KEY=

# Etherscan 免费层（可选）
ETHERSCAN_API_KEY=
