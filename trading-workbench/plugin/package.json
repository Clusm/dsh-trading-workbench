{
  "name": "@local/dsh-trading-workbench",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22.19", "dsh": ">=0.2.2-rc.1 <0.3.0-0" },
  "type": "module",
  "description": "Trading workbench M1.4 plugin for the DSH Web UI: overview, AI decision chain and manual run control over the Host RoundView, with skeleton orders/review/capital views. Host AI chain (M1.3a), service integration (M1.3b), persisted cycles (M1.3c). Demo-only, no keys, no external LLM API.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./host/ai": "./host/ai/index.js",
    "./host/integration": "./host/integration.js",
    "./host/scheduler": "./host/scheduler.js",
    "./host/service-client": "./host/service-client.js",
    "./host/round-view": "./host/round-view.js",
    "./host/session-llm": "./host/session-llm.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client/*.mjs",
    "client/README.md",
    "host/ai/*.js",
    "host/ai/README.md",
    "host/*.js",
    "test/*.test.mjs",
    "test/http-fixture.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "scripts": {
    "check:client": "node client/checks.mjs",
    "check:render": "node client/render-smoke.mjs",
    "test:ai-chain": "node test/ai-chain.test.mjs",
    "test:host": "node test/host-integration.test.mjs",
    "test:session-llm": "node test/session-llm.test.mjs",
    "test:audit": "node test/audit-persistence.test.mjs",
    "test:scheduler": "node test/scheduler.test.mjs",
    "test:host-state": "node test/host-state.test.mjs",
    "test": "node client/checks.mjs && node client/render-smoke.mjs && node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
