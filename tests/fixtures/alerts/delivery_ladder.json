{
  "case_id": "U14-LADDER-1",
  "kind": "delivery",
  "operation": "queue_ladder",
  "time_base": "offsets_ms_from_now",
  "ladder": [
    "UNKNOWN",
    "SUBMITTED",
    "ACCEPTED",
    "DELIVERED",
    "ACKNOWLEDGED"
  ],
  "cases": [
    {
      "id": "L1-http200-only",
      "channel": {
        "channel": "fake-sink",
        "status": "verified",
        "supports_delivery_receipt": false,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": {
        "http_status": 200
      },
      "expect": {
        "submitted": 1,
        "state": "SUBMITTED",
        "delivered_at_ms": null,
        "ack_at_ms": null,
        "confirmed": 0
      },
      "derivation": "K05 `evaluate_state`：只有 submitted_at_ms ⇒ SUBMITTED。HTTP 2xx 不得越过 SUBMITTED 直接宣称送达（规格 §11.2『HTTP成功、供应商接收、设备送达、人确认分开记录』）。"
    },
    {
      "id": "L2-provider-accepted-not-delivered",
      "channel": {
        "channel": "fake-sink",
        "status": "verified",
        "supports_delivery_receipt": true,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": {
        "http_status": 200,
        "provider_receipt": "rcpt-synthetic-A"
      },
      "expect": {
        "submitted": 1,
        "state": "ACCEPTED",
        "delivered_at_ms": null,
        "ack_at_ms": null,
        "confirmed": 0
      },
      "derivation": "R14：供应商『已接受』≠『已送达』。有 provider_receipt 且无 delivered_at_ms ⇒ evaluate_state 给 ACCEPTED；本用例专门断言 state != DELIVERED 且 delivered_at_ms 为 null。"
    },
    {
      "id": "L3-delivered-without-device-receipt",
      "channel": {
        "channel": "fake-sink",
        "status": "verified",
        "supports_delivery_receipt": true,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": {
        "http_status": 200,
        "provider_receipt": "rcpt-synthetic-B",
        "delivered_offset_ms": 0
      },
      "expect": {
        "submitted": 1,
        "state": "ACCEPTED",
        "delivered_at_ms": null,
        "reason_codes": [
          "DELIVERED_WITHOUT_DEVICE_RECEIPT"
        ],
        "confirmed": 0
      },
      "derivation": "通道报了送达时间但**没有**设备回执：不得据此伪造 DELIVERED（规格 §11.2『通道不支持送达回执就不能显示delivered』）。故停留 ACCEPTED、delivered_at_ms 保持 null，并报 DELIVERED_WITHOUT_DEVICE_RECEIPT。"
    },
    {
      "id": "L4-delivered-with-device-receipt",
      "channel": {
        "channel": "fake-sink",
        "status": "verified",
        "supports_delivery_receipt": true,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": {
        "http_status": 200,
        "provider_receipt": "rcpt-synthetic-C",
        "delivered_offset_ms": 0,
        "device_receipt": "dev-receipt-synthetic-C"
      },
      "expect": {
        "submitted": 1,
        "state": "DELIVERED",
        "delivered_at_ms_set": true,
        "ack_at_ms": null,
        "confirmed": 1
      },
      "derivation": "有 provider_receipt + delivered_at_ms + 设备回执三者 ⇒ DELIVERED（K05 transition_state 的 DELIVERED 前置事实齐备）。这是唯一能到 DELIVERED 的路径。delivered_offset_ms=0 使 delivered_at_ms == submitted_at_ms：K05 delivery_violations 只要求三个时间戳**非降序**，相等合法；一旦 delivered < submitted 会被 TIME_ORDER_VIOLATION 拦下（套件另有独立用例覆盖该负例）。"
    },
    {
      "id": "L5-manual-ack-no-device-receipt",
      "channel": {
        "channel": "sms-no-receipt",
        "status": "verified",
        "supports_delivery_receipt": false,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": {
        "http_status": 200
      },
      "manual": {
        "actor": "operator",
        "note": "synthetic call-back confirmed",
        "confirm": true
      },
      "expect": {
        "submitted": 1,
        "manual_ack_accepted": true,
        "state": "ACKNOWLEDGED",
        "delivered_at_ms": null,
        "ack_at_ms_set": true,
        "state_after_dispatch": "SUBMITTED"
      },
      "derivation": "规格 §11.2『通道不能提供设备送达回执时，允许以可审计的人类确认验证端到端演练；状态标为ACKNOWLEDGED而非伪造DELIVERED』。故 state 必须是 ACKNOWLEDGED 而 delivered_at_ms 必须仍为 null。"
    },
    {
      "id": "L6-manual-ack-auto-actor-refused",
      "channel": {
        "channel": "sms-no-receipt",
        "status": "verified",
        "supports_delivery_receipt": false,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": {
        "http_status": 200
      },
      "manual": {
        "actor": "auto",
        "note": "synthetic",
        "confirm": true
      },
      "expect": {
        "submitted": 1,
        "manual_ack_accepted": false,
        "state": "SUBMITTED",
        "delivered_at_ms": null,
        "state_after_dispatch": "SUBMITTED",
        "manual_reason_codes": [
          "MANUAL_ACK_ACTOR_INVALID"
        ]
      },
      "derivation": "人工确认必须由人给出：actor='auto' 属自动执行者 ⇒ 拒绝（MANUAL_ACK_ACTOR_INVALID），状态保持 SUBMITTED。自动路径不得自己给自己开『已确认』。"
    },
    {
      "id": "L7-manual-ack-without-submission-refused",
      "channel": {
        "channel": "sms-no-receipt",
        "status": "unverified",
        "supports_delivery_receipt": false,
        "escalation_path": "operator-phone-synthetic"
      },
      "transport": null,
      "manual": {
        "actor": "operator",
        "note": "synthetic",
        "confirm": true
      },
      "expect": {
        "submitted": 0,
        "manual_ack_accepted": false,
        "state": "UNKNOWN",
        "delivered_at_ms": null,
        "ack_at_ms": null,
        "state_after_dispatch": "UNKNOWN",
        "manual_reason_codes": [
          "MANUAL_ACK_WITHOUT_SUBMISSION"
        ]
      },
      "derivation": "从未提交过任何告警（通道未验证且未演练）时，人工确认没有任何『端到端演练』事实可确认；按 K05 `ACK_WITHOUT_SUBMISSION` 同向拒绝，只留审计记录，状态保持 UNKNOWN，ack_at_ms 保持 null。"
    },
    {
      "id": "L8-unverified-channel-not-submitted",
      "channel": {
        "channel": "unverified",
        "status": "unverified",
        "supports_delivery_receipt": false,
        "escalation_path": ""
      },
      "transport": {
        "http_status": 200,
        "provider_receipt": "rcpt-should-never-be-sent",
        "delivered_offset_ms": -10,
        "device_receipt": "dev-should-never-be-sent"
      },
      "expect": {
        "submitted": 0,
        "blocked": true,
        "state": "UNKNOWN",
        "delivered_at_ms": null,
        "reason_codes": [
          "CHANNEL_UNVERIFIED"
        ]
      },
      "derivation": "真实渠道未确认时保留 OPS_BLOCKED：dispatch_due 在 channel.status != verified 且未显式 drill 时**拒绝提交**，因此即使 transport 声称有设备回执，队列状态也必须停在 UNKNOWN、delivered_at_ms 为 null（不得伪造 DELIVERED）。"
    }
  ]
}
