+    def apply_exchange_quantities(
+        self, client_order_id: str, *, accepted_qty: str, filled_qty: str,
+        working_leaves_qty: str, terminal_unfilled_qty: str, revision: int,
+    ) -> None:
+        """按交易所回报落库三分量（十进制文本），不改变命令种类与端点。"""
+        with self.db.lock:
