.venv/
__pycache__/
*.pyc
/_*.py
.env
.env.local
# data/ 全部属于运行时状态、日志、缓存或备份；源码与测试夹具不得放在这里。
/data/

# 数据库运行时产物（WAL/SHM/自动备份）
data/*.sqlite-shm
data/*.sqlite-wal
data/*.sqlite.bak*

# 运行时状态快照（高频变动，非源码）
data/*_state.json
data/paper_portfolio.json
data/futures_source_ledger.json

# 调试与日志产物
logs/
data/_latest_prompt.txt
data/diag_*.log
data/web_console*.log

# 复盘库运行时快照：代码只写不读（消费路径走 DB 查询），高频漂移污染 git status
knowledge/review_lessons.json

# 临时备份
*.bak_*
