# M1.0 只列键名，不含任何值；本版本 **不会自动加载** .env（需在启动它的 shell 中显式 export）。
# Demo key/secret 在 M1.0 不被读取；`WORKBENCH_API_TOKEN` 会从进程环境读取（本版不自动加载 .env），
# 未设置时 /api/* 为 dev-open；行情探针不使用任何凭据。

# --- 交易/账户（M1.0 未使用，留待后续里程碑）---
BINANCE_DEMO_API_KEY=
BINANCE_DEMO_API_SECRET=

# --- 服务鉴权（未设置时 /api/* 为 dev-open，仅 loopback 可达）---
WORKBENCH_API_TOKEN=

# --- 服务监听与运行 ---
WORKBENCH_HOST=
WORKBENCH_PORT=
WORKBENCH_DATA_DIR=
WORKBENCH_LOG_LEVEL=

# --- 行情基址（必须是 demo 域名；改错会被 demo-only 守卫拒绝）---
WORKBENCH_DEMO_BASE_URL=

# --- 只读探针参数 ---
WORKBENCH_PROBE_SYMBOL=
WORKBENCH_PROBE_INTERVAL=
WORKBENCH_PROBE_LIMIT=
WORKBENCH_PROBE_TIMEOUT_S=
WORKBENCH_PROBE_CACHE_TTL_S=
