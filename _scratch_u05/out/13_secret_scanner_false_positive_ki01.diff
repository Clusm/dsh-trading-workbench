+def stale_allowances(root: Path = PROJECT_ROOT) -> tuple[str, ...]:
+    """登记了却不再命中的误报项：文件改动后登记必须失效（fail-closed）。"""
+    matched = {( _relative(path, root), finding.line, finding.rule)
+               for path, finding in raw_hits(root)}
+    return tuple(
+        "%s:%d rule=%s" % (path, line, rule)
+        for (path, line, rule) in sorted(_REGISTERED_FALSE_POSITIVES)
+        if (path, line, rule) not in matched
+    )
